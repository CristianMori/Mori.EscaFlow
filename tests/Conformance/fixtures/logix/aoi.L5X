<Programs>
<Program Name="P" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Start)Motor(M1,Start,Spd,Run1,MD1);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[JSR(Text,0);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Text" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Motor(M2, Start, Spd, Run2, MD2);]]>
</Line>
<Line Number="1">
<![CDATA[M2.Delay := 250;]]>
</Line>
<Line Number="2">
<![CDATA[Run2 := M2.Running AND NOT M2.Fault;]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
