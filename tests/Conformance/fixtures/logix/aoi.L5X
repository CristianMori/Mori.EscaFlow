<Modules/>
<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="Motor" Revision="2.1" Vendor="Conformance" ExecutePrescan="true" ExecutePostscan="true" ExecuteEnableInFalse="true" CreatedDate="2026-09-28T10:00:00.000Z" CreatedBy="test" EditedDate="2026-09-28T10:00:00.000Z" EditedBy="test" SoftwareRevision="v33.00">
<Description>
<![CDATA[Motor starter]]>
</Description>
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false" ExternalAccess="Read Only"/>
<Parameter Name="Cmd" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read/Write">
<Description>
<![CDATA[run command]]>
</Description>
</Parameter>
<Parameter Name="Speed" TagType="Base" DataType="REAL" Usage="Input" Radix="Float" Required="true" Visible="true" ExternalAccess="Read/Write"/>
<Parameter Name="Delay" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read/Write">
<DefaultData Format="Decorated">
<DataValue DataType="DINT" Radix="Decimal" Value="500"/>
</DefaultData>
</Parameter>
<Parameter Name="Running" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true" ExternalAccess="Read Only"/>
<Parameter Name="Fault" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="true" ExternalAccess="Read Only"/>
<Parameter Name="Data" TagType="Base" DataType="MotorData" Usage="InOut" Required="true" Visible="true"/>
</Parameters>
<LocalTags>
<LocalTag Name="T1" DataType="TIMER" Radix="NullType" ExternalAccess="None"/>
<LocalTag Name="Count" DataType="DINT" Radix="Decimal" ExternalAccess="None"/>
<LocalTag Name="Prev" DataType="BOOL" Radix="Decimal" ExternalAccess="None"/>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Cmd)TON(T1,?,?)XIC(T1.DN)OTE(Running);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(Cmd)ONS(Prev)ADD(Data.Starts,1,Data.Starts)ADD(Count,1,Count);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(Running)GRT(Speed,100.0)OTE(Fault);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Prescan" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Running := 0;]]>
</Line>
<Line Number="1">
<![CDATA[Count := 0;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Postscan" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Running := 0;]]>
</Line>
</STContent>
</Routine>
<Routine Name="EnableInFalse" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Running := 0;]]>
</Line>
<Line Number="1">
<![CDATA[Fault := 0;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
