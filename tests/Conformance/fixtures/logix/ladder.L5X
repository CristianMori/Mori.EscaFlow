<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Comment>
<![CDATA[bits]]>
</Comment>
<Text>
<![CDATA[XIC(A)XIO(B)OTE(Out1)OTL(Out2)OTU(Bits.3);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[XIC(A)ONS(Bits.0)OSR(Bits.1,Pulse)OSF(Bits.2,C);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[EQU(X,Y)NEQ(X,1)GRT(X,2)GEQ(Y,X)LES(Z,X)LEQ(Z,Y)CMP(X+Y>Z)LIM(0,X,10)MEQ(Bits,16#00FF,Y)OTE(Out1);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[XIC(A)TON(T1,?,?)TOF(T2,?,?)RTO(T3,?,?)CTU(C1,?,?)CTD(C2,?,?)XIC(B)RES(T3)RES(C1);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[XIC(A)MOV(X,Y)CLR(Z)ADD(X,Y,Z)SUB(X,1,Z)MUL(X,2,Z)DIV(X,Y,Z)MOD(X,3,Z)AND(X,Y,Bits)OR(X,16#0F,Bits)XOR(Bits,Y,Bits)NOT(X,Y)NEG(X,Z)ABS(R,R)SQR(R,R)CPT(Z,(X+Y)*2-R);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[XIC(B)COP(Src[0],Dst[0],10)CPS(Src[0],Dst[0],10)FLL(0,Dst[0],10);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[XIC(A)JSR(Sub,2,X,Y,Z);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(C)JMP(Skip);]]>
</Text>
</Rung>
<Rung Number="8" Type="N">
<Text>
<![CDATA[XIC(A)[XIC(B) ,XIC(C) [XIO(A) ,XIC(Out1) ] ,EQU(X,Y) ]OTE(Out2);]]>
</Text>
</Rung>
<Rung Number="9" Type="N">
<Text>
<![CDATA[LBL(Skip)XIC(A)MCR();]]>
</Text>
</Rung>
<Rung Number="10" Type="N">
<Text>
<![CDATA[XIC(B)OTE(Out1)TON(T1,?,?);]]>
</Text>
</Rung>
<Rung Number="11" Type="N">
<Text>
<![CDATA[MCR();]]>
</Text>
</Rung>
<Rung Number="12" Type="N">
<Text>
<![CDATA[XIC(A)AFI()NOP()OTE(Out1);]]>
</Text>
</Rung>
<Rung Number="13" Type="N">
<Text>
<![CDATA[XIC(A)GSV(WallClockTime,,DateTime,Clock[0])SSV(Program,P,DisableFlag,X)MSG(Msg1);]]>
</Text>
</Rung>
<Rung Number="14" Type="N">
<Text>
<![CDATA[XIC(A)Blink(Blk,250,Out2);]]>
</Text>
</Rung>
<Rung Number="15" Type="N">
<Text>
<![CDATA[XIC(A)BTD(X,0,Y,8,4)MVM(X,16#FF00,Bits)SWPB(X,REVERSE,Y);]]>
</Text>
</Rung>
<Rung Number="16" Type="N">
<Text>
<![CDATA[XIC(A)CONCAT(S1,S2,S3)MID(S1,3,1,S2)FIND(S1,S2,1,Idx);]]>
</Text>
</Rung>
<Rung Number="17" Type="N">
<Text>
<![CDATA[XIC(A)FOR(Loop,Idx,0,9,1);]]>
</Text>
</Rung>
<Rung Number="18" Type="N">
<Text>
<![CDATA[XIC(B)TND();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Sub" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[SBR(InA,InB);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[ADD(InA,InB,OutA);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[RET(OutA);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
<Routine Name="Loop" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[MOV(Idx,Dst[Idx]);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(Dst[Idx],5)BRK();]]>
</Text>
</Rung>
</RLLContent>
</Routine>
