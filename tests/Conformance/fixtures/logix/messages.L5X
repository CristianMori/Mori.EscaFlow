<Routines>
<Routine Name="Main" Type="RLL">
<RLLContent>
<Rung Number="0" Type="N">
<Text>
<![CDATA[XIC(Trigger)XIO(Read_Remote.EN)MSG(Read_Remote);]]>
</Text>
</Rung>
<Rung Number="1" Type="N">
<Text>
<![CDATA[EQU(State,0)MOV(1,MsgData.Create_Source.Type)MOV(2,MsgData.Create_Source.Addr.Family)MOV(5000,MsgData.Create_Source.Addr.Port)MSG(SKT_Create);]]>
</Text>
</Rung>
<Rung Number="2" Type="N">
<Text>
<![CDATA[XIC(SKT_Create.DN)MOV(MsgData.Instance,SKT_Open.Instance)MOV(MsgData.Instance,SKT_Write.Instance)MOV(MsgData.Instance,SKT_Read.Instance)MOV(MsgData.Instance,SKT_Delete.Instance)MOV(1,State);]]>
</Text>
</Rung>
<Rung Number="3" Type="N">
<Text>
<![CDATA[EQU(State,1)MSG(SKT_Open)XIC(SKT_Open.DN)MOV(2,State);]]>
</Text>
</Rung>
<Rung Number="4" Type="N">
<Text>
<![CDATA[EQU(State,2)MSG(SKT_Write)XIC(SKT_Write.DN)MOV(3,State);]]>
</Text>
</Rung>
<Rung Number="5" Type="N">
<Text>
<![CDATA[EQU(State,3)MSG(SKT_Read)XIC(SKT_Read.DN)MOV(4,State);]]>
</Text>
</Rung>
<Rung Number="6" Type="N">
<Text>
<![CDATA[EQU(State,4)MSG(SKT_Delete)XIC(SKT_Delete.DN)MOV(0,State);]]>
</Text>
</Rung>
<Rung Number="7" Type="N">
<Text>
<![CDATA[XIC(Trigger)MSG(Get_Identity)MOV(ConsCount,ProdCount);]]>
</Text>
</Rung>
</RLLContent>
</Routine>
</Routines>
