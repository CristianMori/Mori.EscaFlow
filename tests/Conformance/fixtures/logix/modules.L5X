<Program Name="P" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Tags/>
<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[Flag := Local:3:I.Data.4 AND NOT DI:I.Fault.0;]]>
</Line>
<Line Number="1">
<![CDATA[ENet:O.Data[0] := Word;]]>
</Line>
<Line Number="2">
<![CDATA[Word := ENet:I.Data[1] + Local:3:I.Data;]]>
</Line>
<Line Number="3">
<![CDATA[Cfg := Turck:C.Channel_Mode_Port1;]]>
</Line>
<Line Number="4">
<![CDATA[Byte0 := Turck:I.Data[0];]]>
</Line>
<Line Number="5">
<![CDATA[Flag := Turck:I.ConnectionFaulted OR ENet:1:I.0 OR AlInput;]]>
</Line>
<Line Number="6">
<![CDATA[DI:O.Data.0 := Flag;]]>
</Line>
</STContent>
</Routine>
</Routines>
