<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<RSLogix5000Content SchemaRevision="1.0" SoftwareRevision="33.00" TargetName="St" TargetType="Controller" ContainsContext="false" ExportDate="Mon Sep 28 10:00:00 2026">
<Controller Use="Target" Name="St" ProcessorType="1756-L85E" MajorRev="33" MinorRev="12">
<DataTypes/>
<Modules/>
<AddOnInstructionDefinitions>
<AddOnInstructionDefinition Name="Blink" Revision="1.0">
<Parameters>
<Parameter Name="EnableIn" TagType="Base" DataType="BOOL" Usage="Input" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="EnableOut" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="false" Visible="false"/>
<Parameter Name="Rate" TagType="Base" DataType="DINT" Usage="Input" Radix="Decimal" Required="true" Visible="true"/>
<Parameter Name="Out" TagType="Base" DataType="BOOL" Usage="Output" Radix="Decimal" Required="true" Visible="true"/>
</Parameters>
<LocalTags>
<LocalTag Name="T1" DataType="TIMER" Radix="NullType"/>
</LocalTags>
<Routines>
<Routine Name="Logic" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[T1.PRE := Rate;]]>
</Line>
<Line Number="1">
<![CDATA[TONR(T1);]]>
</Line>
<Line Number="2">
<![CDATA[Out := T1.DN;]]>
</Line>
</STContent>
</Routine>
</Routines>
</AddOnInstructionDefinition>
</AddOnInstructionDefinitions>
<Tags>
<Tag Name="R" TagType="Base" DataType="REAL" Radix="Float"/>
<Tag Name="D" TagType="Base" DataType="DINT" Radix="Decimal"/>
<Tag Name="S" TagType="Base" DataType="SINT" Radix="Decimal"/>
<Tag Name="L" TagType="Base" DataType="LREAL" Radix="Float"/>
<Tag Name="Word" TagType="Base" DataType="DINT" Radix="Binary"/>
<Tag Name="I" TagType="Base" DataType="DINT" Radix="Decimal"/>
<Tag Name="Flag" TagType="Base" DataType="BOOL" Radix="Decimal"/>
<Tag Name="Str" TagType="Base" DataType="STRING" Radix="NullType"/>
<Tag Name="Str2" TagType="Base" DataType="STRING" Radix="NullType"/>
<Tag Name="Arr" TagType="Base" DataType="DINT" Dimensions="5" Radix="Decimal"/>
<Tag Name="Blk" TagType="Base" DataType="Blink"/>
</Tags>
<Programs>
<Program Name="P" TestEdits="false" MainRoutineName="Main" Disabled="false" UseAsFolder="false">
<Tags>
<Tag Name="InA" TagType="Base" DataType="DINT" Radix="Decimal"/>
<Tag Name="OutA" TagType="Base" DataType="DINT" Radix="Decimal"/>
</Tags>
<Routines>
<Routine Name="Main" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[// implicit conversions]]>
</Line>
<Line Number="1">
<![CDATA[D := R * 2.0;]]>
</Line>
<Line Number="2">
<![CDATA[S := D + 1;]]>
</Line>
<Line Number="3">
<![CDATA[R := L;]]>
</Line>
<Line Number="4">
<![CDATA[L := D / 3;]]>
</Line>
<Line Number="5">
<![CDATA[IF D > 10 AND NOT Flag THEN]]>
</Line>
<Line Number="6">
<![CDATA[    D := 0;]]>
</Line>
<Line Number="7">
<![CDATA[ELSIF D < 0 OR Flag THEN]]>
</Line>
<Line Number="8">
<![CDATA[    D := 10;]]>
</Line>
<Line Number="9">
<![CDATA[ELSE]]>
</Line>
<Line Number="10">
<![CDATA[    D := D + 1;]]>
</Line>
<Line Number="11">
<![CDATA[END_IF;]]>
</Line>
<Line Number="12">
<![CDATA[CASE D OF]]>
</Line>
<Line Number="13">
<![CDATA[    1: Flag := 1;]]>
</Line>
<Line Number="14">
<![CDATA[    2..5, 8: Flag := 0;]]>
</Line>
<Line Number="15">
<![CDATA[ELSE]]>
</Line>
<Line Number="16">
<![CDATA[    Flag := D.0;]]>
</Line>
<Line Number="17">
<![CDATA[END_CASE;]]>
</Line>
<Line Number="18">
<![CDATA[FOR I := 0 TO 4 BY 1 DO]]>
</Line>
<Line Number="19">
<![CDATA[    Arr[I] := I * 2;]]>
</Line>
<Line Number="20">
<![CDATA[    IF Arr[I] > 6 THEN EXIT; END_IF;]]>
</Line>
<Line Number="21">
<![CDATA[END_FOR;]]>
</Line>
<Line Number="22">
<![CDATA[WHILE I > 0 DO I := I - 1; END_WHILE;]]>
</Line>
<Line Number="23">
<![CDATA[REPEAT I := I + 1; UNTIL I >= 3 END_REPEAT;]]>
</Line>
<Line Number="24">
<![CDATA[R := ABS(R) + SQRT(R) - SIN(R);]]>
</Line>
<Line Number="25">
<![CDATA[D := TRUNC(R);]]>
</Line>
<Line Number="26">
<![CDATA[Word.[I] := 1;]]>
</Line>
<Line Number="27">
<![CDATA[Flag := Word.[D];]]>
</Line>
<Line Number="28">
<![CDATA[D := Str.LEN;]]>
</Line>
<Line Number="29">
<![CDATA[Str.DATA[0] := 65;]]>
</Line>
<Line Number="30">
<![CDATA[Str2 := Str;]]>
</Line>
<Line Number="31">
<![CDATA[JSR(Sub, 1, D, Word);]]>
</Line>
<Line Number="32">
<![CDATA[Blink(Blk, 100, Flag);]]>
</Line>
<Line Number="33">
<![CDATA[(* block comment *) Flag := D >= 5 XOR Flag;]]>
</Line>
</STContent>
</Routine>
<Routine Name="Sub" Type="ST">
<STContent>
<Line Number="0">
<![CDATA[SBR(InA);]]>
</Line>
<Line Number="1">
<![CDATA[OutA := InA * 2;]]>
</Line>
<Line Number="2">
<![CDATA[RET(OutA);]]>
</Line>
</STContent>
</Routine>
</Routines>
</Program>
</Programs>
<Tasks>
<Task Name="Main" Type="CONTINUOUS" Priority="10" Watchdog="500" DisableUpdateOutputs="false" InhibitTask="false">
<ScheduledPrograms>
<ScheduledProgram Name="P"/>
</ScheduledPrograms>
</Task>
</Tasks>
</Controller>
</RSLogix5000Content>
